{
  "name": "linguetta",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/language",
    "packages/stremio-server/server",
    "packages/stremio-server/devaddon"
  ],
  "scripts": {
    "predev": "bash scripts/dev-preflight.sh",
    "dev": "bun --filter web dev",
    "build": "bun --filter web build",
    "check": "bun --filter web check",
    "lint": "bun --filter web lint",
    "test": "bun --filter '*' test",
    "test:e2e": "bun --filter web test:e2e"
  }
}
