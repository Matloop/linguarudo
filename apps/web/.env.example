# Local: rode `supabase start` na raiz e copie os valores de `supabase status`.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# IA grátis que preenche o diálogo Guardar (lema, leitura, sentido, frase). Opcionais:
# sem nenhuma chave, o botão responde "IA não configurada". Groq primeiro, Gemini se falhar.
# Chave do Groq: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# Chave do Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# Trocar o modelo (padrões: openai/gpt-oss-120b e gemini-3.8-flash):
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash
